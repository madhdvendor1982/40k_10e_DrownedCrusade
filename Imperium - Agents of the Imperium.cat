        <profile name="Third Eye (Psychic)" id="0995-098b-6cd1-63aa" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Shooting phase, select one enemy unit within 12&quot; of and visible to this model. That enemy unit must take a Battle-shock test, subtracting 2 from the result if it is an INFANTRY unit; if the test is failed, that enemy unit suffers 3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Gaze into the Empyrean (Psychic)" id="5ca2-9f19-aa99-c21d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Enemy units that are set up on the battlefield as Reinforcements cannot be set up within 12&quot; of this model.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="946f-0b3a-1e17-7be8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model can be attached to the following units: IMPERIAL NAVY BREACHERS, VOIDSMEN-AT-ARMS</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntryGroups>
