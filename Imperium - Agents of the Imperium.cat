      <selectionEntryGroups>
        <selectionEntryGroup name="Antiquity Relics" id="0430-fa91-9f33-51b1" hidden="false" sortIndex="2">
          <selectionEntries>
            <selectionEntry name="Icon of Intolerance" id="5834-d727-8b5d-f34b" hidden="false" import="true" type="upgrade">
