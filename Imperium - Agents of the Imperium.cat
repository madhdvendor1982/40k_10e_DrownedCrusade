          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If a CHARACTER unit from your army can be attached to a DEATHWATCH KILL TEAM, it can be attached to this unit instead.</characteristic>
          </characteristics>
