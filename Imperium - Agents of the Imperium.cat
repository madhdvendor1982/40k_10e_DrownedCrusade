              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Add 1 to the Attacks characteristic of the bearer&apos;s melee weapons, and those weapons have the **[ANTI-DAEMON 3+]** ability.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Grimoire of True Names" id="eebd-ca6a-65e2-0694" hidden="false" import="true" type="upgrade">
          <constraints>
