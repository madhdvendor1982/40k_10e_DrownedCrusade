    <selectionEntry name="Detachment" id="1162-9cd5-d6b0-1663" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Configuration" id="34ad-2564-864a-f0f0" hidden="false" primary="true" targetId="4ac9-fd30-1e3d-b249"/>
      </categoryLinks>
      <constraints>
