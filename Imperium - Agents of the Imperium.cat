            <constraint id="8c72-ef7a-9b60-5902" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
            <cost name="Crusade Points" typeId="b03b-c239-15a5-da55" value="1"/>
            <cost name="Crusade: Battle Honours" typeId="75bb-ded1-c86d-bdf0" value="1"/>
            <cost name="Crusade: Experience" typeId="a623-fe74-1d33-cddf" value="0"/>
            <cost name="Crusade: Weapon Modifications" typeId="716d-91b7-d55a-1022" value="0"/>
          </costs>
          <modifiers>
            <modifier field="b03b-c239-15a5-da55" type="set" value="2">
              <conditions>
                <condition childId="5929-ad51-d006-e008" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Void Trader" id="f024-4677-5080-8ed2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If the bearer is on the battlefield at the end of the battle, increase your Crusade force&apos;s Supply Limit by 50 points. At the end of battle, you can select one model from your Crusade force that has one Crusade Relic or one weapon that has a Weapon Modification. If you do, you can remove that Battle Honour from that model - you can either replace that Battle Honour with a different Crusade Relic that model can have or you can gain 1RP.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Highly Placed Ally" id="4c1c-8715-14aa-3084" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a747-5cf0-a995-3695" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="513f-1839-c4d9-6609" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
            <cost name="Crusade Points" typeId="b03b-c239-15a5-da55" value="1"/>
            <cost name="Crusade: Battle Honours" typeId="75bb-ded1-c86d-bdf0" value="1"/>
            <cost name="Crusade: Experience" typeId="a623-fe74-1d33-cddf" value="0"/>
            <cost name="Crusade: Weapon Modifications" typeId="716d-91b7-d55a-1022" value="0"/>
          </costs>
          <modifiers>
            <modifier field="b03b-c239-15a5-da55" type="set" value="2">
              <conditions>
                <condition childId="5929-ad51-d006-e008" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Highly Placed Ally" id="87dc-af0a-3ddc-43ca" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If the bearer is your **^^Warlord^^**, start the battle with 1CP. If the bearer is on the battlefield at the end of the battle and you won that battle, roll one D6: on a 4+, you gain 1RP.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Secret Forces" id="f111-b1b8-a9f2-a5b1" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c9da-b768-cd3f-20c3" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="fa05-96e2-dc8a-f1f2" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
