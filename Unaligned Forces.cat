                    <constraint id="72de-5d3a-0e0b-c56d" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <profiles>
                    <profile name="Cutting Gear" id="1720-1fcb-8c98-5712" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time the bearer ends a Normal move, you can open one Hatchway that is within 1&quot; of it. Your opponent cannot attempt to prevent that Hatchway from opening.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
