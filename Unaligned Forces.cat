      <selectionEntryGroups>
        <selectionEntryGroup name="Wargear Options" id="8ba1-e792-2c9e-32d4" defaultSelectionEntryId="f9fb-6fda-429e-91f2" hidden="false">
          <constraints>
            <constraint id="d7be-2f3a-45a0-7e5b" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="67ff-2636-7a5a-444e" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
