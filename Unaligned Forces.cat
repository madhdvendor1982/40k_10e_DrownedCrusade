      <infoLinks>
        <infoLink name="Deep Strike" id="435a-e270-1c67-af4" hidden="false" targetId="7cb5-dd6b-dd87-ad3b" type="rule"/>
        <infoLink name="Feel No Pain" id="2308-ce93-5765-7e7e" hidden="false" targetId="9bf4-280f-bbe2-6fbb" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="5+"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifierGroups>
        <modifierGroup type="and">
          <comment>Crusade modifiers</comment>
          <modifiers>
            <modifier field="ea7e-128d-7046-fde8" type="increment" value="2">
              <repeats>
                <repeat childId="d1a5-4297-168b-11cd" field="selections" includeChildSelections="true" repeats="1" roundUp="false" scope="self" shared="true" value="1"/>
              </repeats>
            </modifier>
            <modifier field="2b0a-c821-f8f8-6f36" type="increment" value="2">
              <repeats>
                <repeat childId="d1a5-4297-168b-11cd" field="selections" includeChildSelections="true" repeats="1" roundUp="false" scope="self" shared="true" value="1"/>
              </repeats>
            </modifier>
            <modifier field="name" type="append" value="(Battle-ready)">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="2dbf-4d49-5d74-85c9" field="selections" includeChildSelections="true" scope="self" shared="true" type="atMost" value="5"/>
                    <condition childId="cac3-71d1-ea4b-795d" field="forces" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
            <modifier field="name" type="append" value="(Blooded)">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="2dbf-4d49-5d74-85c9" field="selections" includeChildSelections="true" scope="self" shared="true" type="greaterThan" value="5"/>
                    <condition childId="2dbf-4d49-5d74-85c9" field="selections" includeChildSelections="true" scope="self" shared="true" type="atMost" value="15"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
            <modifier field="name" type="append" value="(Battle-hardened)">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="2dbf-4d49-5d74-85c9" field="selections" includeChildSelections="true" scope="self" shared="true" type="greaterThan" value="15"/>
                    <condition childId="2dbf-4d49-5d74-85c9" field="selections" includeChildSelections="true" scope="self" shared="true" type="atMost" value="30"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
            <modifier field="name" type="append" value="(Heroic)">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="2dbf-4d49-5d74-85c9" field="selections" includeChildSelections="true" scope="self" shared="true" type="greaterThan" value="30"/>
                    <condition childId="2dbf-4d49-5d74-85c9" field="selections" includeChildSelections="true" scope="self" shared="true" type="atMost" value="50"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
            <modifier field="name" type="append" value="(Legendary)">
              <conditions>
                <condition childId="2dbf-4d49-5d74-85c9" field="selections" includeChildSelections="true" scope="self" shared="true" type="greaterThan" value="50"/>
              </conditions>
            </modifier>
          </modifiers>
        </modifierGroup>
      </modifierGroups>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditionGroups>
            <conditionGroup type="or">
              <conditions>
                <condition childId="9ed-cbf4-bfe5-90bf" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="lessThan" value="1"/>
                <condition childId="2973-ea51-7f8d-5403" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="lessThan" value="1"/>
